---
import BaseLayout from "../layouts/BaseLayout.astro";
import UploadZone from "../components/UploadZone.tsx";
---
<BaseLayout title="Ingest — Architecture Archaeologist">
<h1 class="page-title">Ingest a codebase</h1>
<div class="note-band mb-4">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
    <path d="M12 8v5M12 16h.01" />
  </svg>
  <p>
    <strong>Site notice.</strong> Only upload code you own or are authorised to share. Proprietary code needs
    consent — tick the checkbox below to confirm.
  </p>
</div>
<UploadZone client:load />
</BaseLayout>
