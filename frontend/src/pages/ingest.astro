---
import BaseLayout from "../layouts/BaseLayout.astro";
import UploadZone from "../components/UploadZone.tsx";
---
<BaseLayout title="Ingest — Architecture Archaeologist">
<h1 class="mb-2 text-2xl font-bold">Ingest a codebase</h1>
<p class="mb-4 border border-archamber/50 bg-panel p-3 text-sm text-archamber">⚠ Only upload code you own or are authorised to share. Proprietary code needs consent — tick the checkbox to confirm.</p>
<UploadZone client:load />
</BaseLayout>
