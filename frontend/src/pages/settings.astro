---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Settings — Architecture Archaeologist">
<h1 class="page-title">Settings</h1>
<div class="sheet-panel">
  <div class="sheet-panel-head">
    <span class="panel-code">Sheet A-06 — Register</span>
    <span>Stored codebases · local backend</span>
  </div>
  <div class="sheet-panel-body">
    <div class="register-head">
      <h2>Codebases</h2>
      <span>Delete removes the local survey</span>
    </div>
    <ul id="list" class="register-list"></ul>
    <p id="err" class="form-note error"></p>
  </div>
</div>
<script>
  import { apiGet, apiDelete } from '../lib/apiClient';
  async function load() {
    const list = document.getElementById("list")!;
    const err = document.getElementById("err")!;
    err.textContent = "";
    list.innerHTML = '<li class="register-empty">Loading…</li>';
    try {
      const items = await apiGet("/api/codebase");
      list.innerHTML = "";
      if (items.length === 0) list.innerHTML = '<li class="register-empty">No codebases yet.</li>';
      for (const c of items) {
        const li = document.createElement("li");
        li.className = "register-row";
        const span = document.createElement("span");
        span.className = "reg-name";
        span.textContent = `#${c.id} ${c.name} (${c.source}, ${c.files} files)`;
        const del = document.createElement("button");
        del.type = "button";
        del.textContent = "Delete";
        del.className = "btn btn-sm danger";
        del.onclick = async () => {
          try {
            await apiDelete(`/api/codebase/${c.id}`);
            await load();
          } catch (e) {
            err.textContent = e instanceof Error ? e.message : "Delete failed.";
          }
        };
        li.append(span, del);
        list.appendChild(li);
      }
    } catch (e) {
      list.innerHTML = "";
      err.textContent = e instanceof Error ? e.message : "Load failed.";
    }
  }
  load();
</script>
</BaseLayout>
