---
const links: { href: string; label: string; sheet: string }[] = [
  { href: '/', label: 'Home', sheet: 'A-01' },
  { href: '/ingest', label: 'Ingest', sheet: 'A-02' },
  { href: '/report', label: 'Report', sheet: 'A-03' },
  { href: '/explorer', label: 'Explorer', sheet: 'A-04' },
  { href: '/ask', label: 'Ask', sheet: 'A-05' },
  { href: '/settings', label: 'Settings', sheet: 'A-06' },
];

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const full = href === '/' ? base || '/' : `${base}${href}`;
  return cur === (full.replace(/\/+$/, '') || '/');
};
const path = Astro.url.pathname.replace(base, '').replace(/\/+$/, '') || '/';
const current = links.find((l) => l.href === path) ?? links[0];
---
<div class="revision-band">
  <div class="revision-inner">
    <span>Adineo / survey services</span>
    <span class="rev-mid">Codebase forensics · static survey · local backend</span>
    <span><span class="rev-mark">Rev 03</span> · 28.10.2026</span>
  </div>
</div>
<header class="nav">
  <div class="nav-inner">
    <a href={base || '/'} class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2 3 21h18L12 2Z" />
          <path d="M12 7v9" />
          <circle cx="12" cy="18" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="brand-text">
        <span>Architecture Archaeologist</span>
        <span class="brand-sub">Sheet {current.sheet} / 06 · Survey set</span>
      </span>
    </a>
    <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <nav id="nav-menu" class="nav-menu" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li>
            <a
              href={l.href === '/' ? base || '/' : `${base}${l.href}`}
              data-navlink={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              <span class="nav-ref">{l.sheet}</span>
              <span class="nav-label">{l.label}</span>
            </a>
          </li>
        ))}
        <li class="nav-cta-wrap">
          <a href={`${base}/ingest`} class="nav-link nav-cta">Ingest code</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const close = () => {
      menu.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (menu.classList.contains('open') && !menu.contains(target) && !toggle.contains(target)) {
        close();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
