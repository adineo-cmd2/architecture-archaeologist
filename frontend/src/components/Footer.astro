---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const year = new Date().getFullYear();
const date = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' })
  .format(new Date())
  .replace(/\//g, '.');
const links: { href: string; label: string }[] = [
  { href: '/', label: 'Home' },
  { href: '/ingest', label: 'Ingest' },
  { href: '/report', label: 'Report' },
  { href: '/explorer', label: 'Explorer' },
  { href: '/ask', label: 'Ask' },
  { href: '/settings', label: 'Settings' },
];
---
<footer class="footer">
  <div class="footer-grid">
    <div class="footer-cell footer-identity">
      <a href={base || '/'} class="brand">
        <span class="brand-mark" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2 3 21h18L12 2Z" />
            <path d="M12 7v9" />
            <circle cx="12" cy="18" r="1.5" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <span class="brand-text">
          <span>Architecture Archaeologist</span>
          <span class="brand-sub">Dig up what the dev was thinking</span>
        </span>
      </a>
      <p>
        Only upload code you own or are authorised to share. Static heuristic analysis — patterns and drift scores
        are estimates, not ground truth.
      </p>
    </div>
    <div class="footer-cell">
      <h4>Drawing index</h4>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href === '/' ? base || '/' : `${base}${l.href}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="footer-cell">
      <h4>Project</h4>
      <ul class="footer-links">
        <li><a href="https://github.com/adineo-cmd2/architecture-archaeologist" target="_blank" rel="noreferrer">Source on GitHub ↗</a></li>
        <li><a href="https://adineo-cmd2.github.io/architecture-archaeologist/" target="_blank" rel="noreferrer">Live site ↗</a></li>
        <li><span>Local backend · <span class="mono">localhost:8007</span></span></li>
        <li><span>FastAPI + Astro + React</span></li>
      </ul>
    </div>
    <div class="footer-cell footer-titleblock">
      <h4>Title block</h4>
      <dl>
        <div><dt>Project</dt><dd>Architecture Archaeologist</dd></div>
        <div><dt>Sheet</dt><dd>A-01 / 06 · Survey set</dd></div>
        <div><dt>Scale</dt><dd>1:100 at A3 · NTS</dd></div>
        <div><dt>Revision</dt><dd>03 — issued for survey</dd></div>
        <div><dt>Drawn</dt><dd>Aditya Yadav</dd></div>
        <div><dt>Date</dt><dd>{date}</dd></div>
      </dl>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} Architecture Archaeologist · Aditya Yadav</span>
      <span>Deployed on GitHub Pages</span>
      <span>Survey set A · Sheet A-01 / 06 · Rev 03</span>
    </div>
  </div>
</footer>
